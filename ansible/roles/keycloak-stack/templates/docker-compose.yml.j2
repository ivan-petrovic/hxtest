services:
  postgres:
    image: postgres:17-alpine
    restart: unless-stopped
    container_name: postgres
    environment:
      POSTGRES_DB: {{ postgres_db }}
      POSTGRES_USER: {{ postgres_user }}
      POSTGRES_PASSWORD: {{ postgres_password }}
    volumes:
      - pgdata:/var/lib/postgresql/data
    networks:
      - keycloak-net

  keycloak:
    image: quay.io/keycloak/keycloak:26.3.4
    restart: unless-stopped
    container_name: keycloak
    command: ["start-dev", "--import-realm", "--http-enabled=true", "--health-enabled=true", "--http-port=8080"]
    environment:
      KC_DB: postgres
      KC_DB_URL_HOST: postgres
      KC_DB_URL_DATABASE: {{ postgres_db }}
      KC_DB_USERNAME: {{ postgres_user }}
      KC_DB_PASSWORD: {{ postgres_password }}
      KC_PROXY: passthrough
      KC_BOOTSTRAP_ADMIN_USERNAME: {{ keycloak_admin_user }}
      KC_BOOTSTRAP_ADMIN_PASSWORD: {{ keycloak_admin_password }}
    volumes:
      - ./myrealm-realm.json:/opt/keycloak/data/import/myrealm-realm.json:ro
    ports:
      - "8080:8080"
      - "9000:9000"
    depends_on:
      - postgres
    networks:
      - keycloak-net

  oauth2-proxy:
    image: quay.io/oauth2-proxy/oauth2-proxy:v7.12.0
    restart: unless-stopped
    container_name: oauth2-proxy
    environment:
      OAUTH2_PROXY_PROVIDER: oidc
      OAUTH2_PROXY_CLIENT_ID: {{ oauth2_client_id }}
      OAUTH2_PROXY_CLIENT_SECRET: {{ oauth2_client_secret }}
      OAUTH2_PROXY_UPSTREAMS: "http://web:80/"
      OAUTH2_PROXY_HTTP_ADDRESS: "0.0.0.0:4180"
      OAUTH2_PROXY_COOKIE_SECRET: {{ oauth2_cookie_secret }}
      OAUTH2_PROXY_COOKIE_SECURE: "false"
      OAUTH2_PROXY_COOKIE_SAMESITE: lax
      OAUTH2_PROXY_OIDC_ISSUER_URL: http://{{ public_hostname }}:8080/realms/myrealm
      OAUTH2_PROXY_REDIRECT_URL: http://{{ public_hostname }}/oauth2/callback
      OAUTH2_PROXY_EMAIL_DOMAINS: "*"
      OAUTH2_PROXY_SKIP_PROVIDER_VERIFICATION: "true"
    depends_on:
      - keycloak
      - web
    networks:
      - keycloak-net

  web:
    image: nginx:stable-alpine
    container_name: web
    volumes:
      - ./web:/usr/share/nginx/html:ro
    networks:
      - keycloak-net

  nginx:
    image: nginx:stable-alpine
    container_name: nginx
    restart: unless-stopped
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
    ports:
      - "80:80"
    depends_on:
      - oauth2-proxy
      - keycloak
      - web
    networks:
      - keycloak-net

volumes:
  pgdata:

networks:
  keycloak-net:
    driver: bridge
